{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/backend/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/backend/(.*)$", "dest": "/api/backend/$1" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
