{
  "version": 2,
  "functions": {
    "frontend/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "backend/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/frontend/index.php" },
    { "src": "^/backend/(.*)$", "dest": "/backend/$1" },
    { "src": "^/frontend/(.*)$", "dest": "/frontend/$1" },
    { "src": "^/(.*)$", "dest": "/frontend/$1" }
  ]
}
