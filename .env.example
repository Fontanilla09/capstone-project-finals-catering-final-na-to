# Application. Live checkout requires production mode and HTTPS; Vercel's VERCEL_ENV is also supported.
APP_URL=http://localhost:8000
APP_ENV=development
VITE_API_BASE=http://localhost:8000
VITE_FRONTEND_URL=http://localhost:5173

# PayPal checkout and payouts
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ADMIN_EMAIL=
PAYPAL_PAYOUTS_ENABLED=true
FRONTEND_URL=http://localhost:5173

# PayMongo hosted checkout (QR Ph)
PAYMONGO_MODE=live
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# NanoBanana image generation
AI_IMAGE_PROVIDER=nanobanana
NANOBANANA_API_KEY=

# Supabase client and server configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
