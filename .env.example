# PayMongo Configuration
# Copy this file to .env and fill in your PayMongo credentials from https://dashboard.paymongo.com

# Get these from your PayMongo Dashboard
PAYMONGO_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE
PAYMONGO_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cateraiDB

# Application
APP_URL=http://localhost:5173
APP_ENV=development
