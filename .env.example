# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cateraiDB

# Application
APP_URL=http://localhost:5173
APP_ENV=development

# NVIDIA NIM image generation
# Hosted NVIDIA API endpoint. Override this only when using a local NIM container.
NVIDIA_NIM_IMAGE_ENDPOINT=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
NVIDIA_NIM_MODEL=black-forest-labs/FLUX.1-dev
NVIDIA_NIM_API_KEY=
# NVIDIA_API_KEY is also accepted as an alternative variable name.
